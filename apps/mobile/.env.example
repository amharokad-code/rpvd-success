# Copie ce fichier vers .env (jamais commité). Seules des valeurs PUBLIQUES vont ici : la clé
# anon Supabase et les clés SDK publiques RevenueCat sont faites pour être embarquées dans l'app.
EXPO_PUBLIC_SUPABASE_URL=https://<ton-projet>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_URL=https://<ton-site>.netlify.app/.netlify/functions
EXPO_PUBLIC_WEB_URL=https://<ton-site>.netlify.app
# Clés SDK publiques RevenueCat (Project settings > API keys), une par plateforme.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# RPVD Success — variables d'environnement
# Copie ce fichier en `.env` (serveur / Netlify Functions) et `.env.local` (Vite, préfixe VITE_).
# En production, déclare les mêmes variables dans Netlify > Site configuration > Environment variables.

# ---------------------------------------------------------------------------
# Supabase
# Dans le tableau de bord Supabase : Authentication > Providers > Anonymous
# → activer « Allow anonymous sign-ins » (l'app s'identifie avec une session anonyme).
# Exécute ensuite `supabase_schema.sql` dans l'éditeur SQL (idempotent).
# ---------------------------------------------------------------------------
SUPABASE_URL=
# Clé « service_role » (secrète, serveur uniquement — jamais côté client).
SUPABASE_SERVICE_KEY=
# Mêmes valeurs publiques pour le front (clé « anon »).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Gemini (Google AI Studio) — API REST, clé serveur uniquement.
# `GOOGLE_AI_STUDIO_API_KEY` est accepté comme alias.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Stripe
# Webhook : Developers > Webhooks > Add endpoint
#   URL       : https://<ton-site>.netlify.app/.netlify/functions/stripe-webhook
#   Événement : checkout.session.completed
# En local : `stripe listen --forward-to localhost:8888/.netlify/functions/stripe-webhook`
# (le secret « whsec_… » affiché par la CLI va dans STRIPE_WEBHOOK_SECRET).
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optionnel : Price IDs Stripe (sinon price_data 12,99 $ / 24,99 $ CAD à la volée).
STRIPE_PRICE_SOLO=
STRIPE_PRICE_TRIO=
# Clé publique (front), optionnelle : le checkout est créé côté serveur.
VITE_STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Courriels (Resend) — https://resend.com > API Keys
# Sans RESEND_API_KEY hors production, les codes d'essai sont renvoyés dans
# la réponse (`dev_codes`) et affichés dans la console : dev local seulement.
# EMAIL_FROM doit utiliser un domaine vérifié chez Resend (ex. "RPVD Success <codes@tondomaine.ca>").
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=

# ---------------------------------------------------------------------------
# Meta Conversions API (server-side) — envoie l'événement 'Purchase' du Bootcamp depuis stripe-webhook.js,
# SEULEMENT si l'acheteur a coché la case facultative de /reserver (consentement, Loi 25). Sans case : rien.
# Meta Events Manager > Sources de données > ton pixel > Paramètres > Conversions API
#   META_PIXEL_ID            : identifiant du pixel (ex. 1234567890)
#   META_CAPI_ACCESS_TOKEN   : token d'accès système généré dans Events Manager (secret, serveur uniquement)
#   META_CAPI_TEST_EVENT_CODE: optionnel — code de test pour valider dans l'onglet "Test Events" avant prod
# Best-effort : si absentes, l'événement est simplement ignoré (le webhook Stripe continue de fonctionner).
# ---------------------------------------------------------------------------
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=
# Optionnel : version de l'API Graph (défaut v25.0, publiée en février 2026).
META_GRAPH_VERSION=

# ---------------------------------------------------------------------------
# Snap Conversions API v3 (server-side) — envoie 'PURCHASE' du Bootcamp, mêmes règles de consentement.
# Snap Ads Manager > Events Manager > ton pixel > Conversions API > « Generate token ».
#   SNAP_PIXEL_ID   : identifiant du pixel Snap (format UUID). Même valeur que VITE_SNAP_PIXEL_ID.
#   SNAP_CAPI_TOKEN : jeton Conversions API (secret, serveur uniquement).
# Best-effort : si absentes, l'événement est simplement ignoré (le webhook Stripe continue de fonctionner).
# ---------------------------------------------------------------------------
SNAP_PIXEL_ID=
SNAP_CAPI_TOKEN=

# ---------------------------------------------------------------------------
# Pixels navigateur (variables PUBLIQUES Vite : à mettre dans .env.local ET dans Netlify, puis redéployer
# car elles sont lues à la compilation). Les pixels ne se chargent QU'APRÈS « Tout accepter » dans le
# bandeau de témoins ; sans ces variables (ou si elles sont invalides) le module est inerte : aucun script.
#   VITE_META_PIXEL_ID : même identifiant que META_PIXEL_ID (chiffres seulement).
#   VITE_SNAP_PIXEL_ID : même identifiant que SNAP_PIXEL_ID (UUID).
# Voir campagne/08-suivi-et-tracking.md.
# ---------------------------------------------------------------------------
VITE_META_PIXEL_ID=
VITE_SNAP_PIXEL_ID=

# ---------------------------------------------------------------------------
# Zoom (Server-to-Server OAuth) — liens personnels du Bootcamp. Sans elles, le lien collé dans l'admin sert.
# marketplace.zoom.us > Develop > Build App > Server-to-Server OAuth. Scopes requis : voir scripts/check-zoom.cjs.
# Vérifie tout avec : npm run check:zoom -- ton-courriel@exemple.com
#   ZOOM_HOST_EMAIL : optionnel, courriel du compte Zoom hôte si Zoom répond « User does not exist: me ».
# ---------------------------------------------------------------------------
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST_EMAIL=

# ---------------------------------------------------------------------------
# Netlify (fournies automatiquement en production, utiles en local)
# URL     : origine publique du site (CORS + redirections Stripe). Local : http://localhost:5173
# CONTEXT : "production" sur Netlify ; laisse vide en local.
# ---------------------------------------------------------------------------
URL=
CONTEXT=
